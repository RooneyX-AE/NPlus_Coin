class ChainStorage:
    def __init__(self, data_dir, logger):
        self.state_file = data_dir / "chain_state.json"
        self.logger = logger

    def load(self):
        state = read_json(self.state_file)
        if state:
            self.logger.info(f"Chain state loaded: height={state.get('height', 0)} | difficulty={state.get('difficulty', '?')}")
        return state

    def save(self, blockchain):
        data = {
            "height": blockchain.height,
            "difficulty": blockchain.difficulty,
            "total_mined_coins": blockchain.total_mined_coins,
            "last_hash": blockchain.latest_block.hash,
            "last_saved": time.strftime("%Y-%m-%d %H:%M:%S"),
            "recent_blocks": [b.to_dict() for b in blockchain.recent_blocks[-MAX_RECENT_BLOCKS:]],
            "recent_block_times": blockchain.block_times[-DIFFICULTY_ADJUSTMENT_INTERVAL:]
        }
        atomic_write_json(self.state_file, data)

# ============================================================
# BLOCKCHAIN - ĐÃ FIX
# ============================================================

class NPlusBlockchain:
    def __init__(self, config, logger, saved_state=None):
        self.config = config
        self.logger = logger
        self.symbol = config.get("symbol", "NPC")
        self.initial_reward = int(config.get("initial_block_reward", 50))
        self.total_supply_cap = int(config.get("total_supply_cap", 1_000_000_000))
        self.difficulty = int(config.get("difficulty", 4))
        self.height = 0
        self.total_mined_coins = 0
        self.block_times = []
        self.recent_blocks = []

        if saved_state and saved_state.get("recent_blocks"):
            self._restore_from_state(saved_state)
        else:
            self._create_genesis_block()

    def _create_genesis_block(self):
        genesis = Block(index=0, previous_hash="0" * 64, timestamp=time.time(), data={"type": "genesis", "message": "NPlus genesis block"})
        self.latest_block = genesis
        self.height = 0
        self.recent_blocks = [genesis]
        self.logger.info(f"Genesis block created: {genesis.hash[:16]}...")

    def _restore_from_state(self, state):
        try:
            blocks = [Block.from_dict(b) for b in state["recent_blocks"]]
            self.recent_blocks = blocks[-MAX_RECENT_BLOCKS:]
            self.latest_block = self.recent_blocks[-1]
            self.height = int(state.get("height", self.latest_block.index))
            self.difficulty = int(state.get("difficulty", self.difficulty))
            self.total_mined_coins = int(state.get("total_mined_coins", 0))
            self.block_times = state.get("recent_block_times", [])[-DIFFICULTY_ADJUSTMENT_INTERVAL:]
            self.logger.info(f"Blockchain restored: height={self.height} | latest={self.latest_block.hash[:16]}...")
        except Exception as e:
            self.logger.error(f"Failed to restore chain state: {e}")
            self._create_genesis_block()

    def get_latest_block(self):
        return self.latest_block

    def get_reward_for_next_block(self):
        # === FIX CHÍNH Ở ĐÂY ===
        # Trước: reward = 50 // (2 ** halvings) -> càng đào càng ít
        # Sau: reward cố định = initial_reward
        reward = self.initial_reward
        remaining_supply = self.total_supply_cap - self.total_mined_coins
        return max(0, min(reward, remaining_supply))

    def proof_of_work(self, block, difficulty):
        target_prefix = "0" * difficulty
        block.nonce = 0
        computed_hash = block.compute_hash()
        hashes = 1
        start = time.time()
        while not computed_hash.startswith(target_prefix):
            block.nonce += 1
            computed_hash = block.compute_hash()
            hashes += 1
        duration = time.time() - start
        block.hash = computed_hash
        self.block_times.append(duration)
        return hashes, duration

    def add_block(self, block, difficulty_used):
        latest = self.get_latest_block()
        if block.previous_hash!= latest.hash:
            self.logger.error("Block rejected: previous hash mismatch.")
            return False
        if not block.hash.startswith("0" * difficulty_used):
            self.logger.error("Block rejected: invalid proof of work.")
            return False
        self.latest_block = block
        self.height = block.index
        self.recent_blocks.append(block)
        self.recent_blocks = self.recent_blocks[-MAX_RECENT_BLOCKS:]
        self.adjust_difficulty()
        return True

    def adjust_difficulty(self):
        if len(self.block_times) < DIFFICULTY_ADJUSTMENT_INTERVAL:
            return
        recent = self.block_times[-DIFFICULTY_ADJUSTMENT_INTERVAL:]
        avg_time = sum(recent) / len(recent)
        old = self.difficulty
        if avg_time < TARGET_BLOCK_TIME * 0.5:
            self.difficulty = min(MAX_DIFFICULTY, self.difficulty + 1)
        elif avg_time > TARGET_BLOCK_TIME * 2.0:
            self.difficulty = max(MIN_DIFFICULTY, self.difficulty - 1)
        self.block_times.clear()
        if self.difficulty!= old:
            self.logger.info(f"Difficulty adjusted: {old} -> {self.difficulty} (avg block time: {avg_time:.2f}s)")

    def supply_reached(self):
        return self.total_mined_coins >= self.total_supply_cap

