def initialize_environment():
    global ROOT_PATH
    try:
        from google.colab import drive
        drive_root = Path("/content/drive")
        my_drive = drive_root / "MyDrive"
        if not my_drive.exists():
            print("Connecting to Google Drive...", flush=True)
            drive.mount("/content/drive")
        else:
            print("Google Drive already mounted.", flush=True)
    except ImportError:
        ROOT_PATH = LOCAL_FALLBACK_PATH
        print("Not running in Colab. Using local path.", flush=True)
    except Exception as e:
        ROOT_PATH = LOCAL_FALLBACK_PATH
        print(f"Drive mount failed: {e}. Using local path.", flush=True)

    if FORCE_RESET and ROOT_PATH.exists():
        shutil.rmtree(ROOT_PATH)
        print("FORCE_RESET=True, old data removed.", flush=True)

    for folder in ["contracts", "config", "logs", "wallet", "data", "src"]:
        (ROOT_PATH / folder).mkdir(parents=True, exist_ok=True)

    log_file = ROOT_PATH / "logs" / "miner.log"
    root_logger = logging.getLogger()
    if root_logger.handlers:
        root_logger.handlers.clear()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
        handlers=[
            logging.FileHandler(log_file, mode="a", encoding="utf-8"),
            logging.StreamHandler()
        ]
    )
    logger = logging.getLogger("NPlusMiner")
    logger.info(f"Environment ready at: {ROOT_PATH}")
    return logger

