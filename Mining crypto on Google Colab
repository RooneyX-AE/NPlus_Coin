def run_continuous_miner():
    logger = initialize_environment()
    setup_project_files(logger)
    config_path = ROOT_PATH / "config" / "network.json"
    wallet_path = ROOT_PATH / "wallet" / "balance.json"
    data_dir = ROOT_PATH / "data"
    config = read_json(config_path, DEFAULT_CONFIG)
    wallet = WalletManager(wallet_path=wallet_path, logger=logger, default_address=config.get("miner_address") or generate_address())
    storage = ChainStorage(data_dir, logger)
    saved_state = storage.load()
    blockchain = NPlusBlockchain(config=config, logger=logger, saved_state=saved_state)

    wallet_total = wallet.get_total_rewards()
    if wallet_total > blockchain.total_mined_coins:
        blockchain.total_mined_coins = wallet_total
        logger.warning("Wallet rewards are higher than chain state. Using wallet total as mined supply baseline.")

    if wallet.data["blocks_mined"] > blockchain.height:
        logger.warning(f"Wallet shows {wallet.data['blocks_mined']} mined blocks, but chain state height is {blockchain.height}. Mining will continue from saved chain height.")

    logger.info(f"Continuous mining started | Coin: {config.get('coin_name', 'NPlus Coin')} ({blockchain.symbol}) | Height: {blockchain.height} | Difficulty: {blockchain.difficulty}")
    logger.info(f"Wallet: {wallet.get_summary()}")
    logger.info(f"Supply cap: {blockchain.total_supply_cap:,} {blockchain.symbol}")
    logger.info("=" * 60)

    session_blocks = 0
    session_rewards = 0
    total_hashes = 0
    start_time = time.time()
    last_report = start_time

    try:
        while True:
            if blockchain.supply_reached():
                logger.info("Supply cap reached. Mining stopped.")
                break
            reward = blockchain.get_reward_for_next_block()
            if reward <= 0:
                logger.info("No remaining reward available. Mining stopped.")
                break
            latest = blockchain.get_latest_block()
            next_index = blockchain.height + 1
            difficulty_used = blockchain.difficulty
            block_data = {
                "type": "mining_reward",
                "height": next_index,
                "miner": wallet.data["address"],
                "reward": reward,
                "symbol": blockchain.symbol,
                "created_at": time.strftime("%Y-%m-%d %H:%M:%S")
            }
            new_block = Block(index=next_index, previous_hash=latest.hash, timestamp=time.time(), data=block_data)
            hashes, duration = blockchain.proof_of_work(new_block, difficulty_used)
            total_hashes += hashes
            if blockchain.add_block(new_block, difficulty_used):
                blockchain.total_mined_coins += reward
                new_balance = wallet.add_reward(reward)
                storage.save(blockchain)
                session_blocks += 1
                session_rewards += reward
                block_rate = hashes / duration if duration > 0 else 0
                logger.info(f"Block #{new_block.index} | diff={difficulty_used} | nonce={new_block.nonce:,} | +{reward} {blockchain.symbol} | balance={new_balance:,} {blockchain.symbol} | {block_rate:,.0f} H/s | {new_block.hash[:16]}...")
                if session_blocks % CHECKPOINT_LOG_INTERVAL == 0:
                    logger.info(f"Checkpoint saved | height={blockchain.height} | balance={wallet.get_balance():,} {blockchain.symbol}")
            now = time.time()
            if now - last_report >= STATUS_REPORT_INTERVAL:
                elapsed = now - start_time
                avg_hashrate = total_hashes / elapsed if elapsed > 0 else 0
                logger.info(f"Status | session_blocks={session_blocks} | session_rewards={session_rewards:,} {blockchain.symbol} | total_hashes={total_hashes:,} | avg_hashrate={avg_hashrate:,.0f} H/s | balance={wallet.get_balance():,} {blockchain.symbol} | height={blockchain.height} | difficulty={blockchain.difficulty}")
                last_report = now
    except KeyboardInterrupt:
        logger.info("Mining stopped by user.")
    except Exception as e:
        logger.error(f"Mining error: {e}", exc_info=True)
    finally:
        wallet.save()
        storage.save(blockchain)
        elapsed = time.time() - start_time
        avg_hashrate = total_hashes / elapsed if elapsed > 0 else 0
        logger.info("=" * 60)
        logger.info("Session summary")
        logger.info(f"Session blocks: {session_blocks}")
        logger.info(f"Session rewards: {session_rewards:,} {blockchain.symbol}")
        logger.info(f"Final balance: {wallet.get_summary()}")
        logger.info(f"Chain height: {blockchain.height}")
        logger.info(f"Current difficulty: {blockchain.difficulty}")
        logger.info(f"Total hashes: {total_hashes:,}")
        logger.info(f"Average hashrate: {avg_hashrate:,.2f} H/s")
        logger.info(f"Wallet file: {wallet_path}")
        logger.info(f"Chain state file: {data_dir / 'chain_state.json'}")
        logger.info("=" * 60)

if __name__ == "__main__":
    run_continuous_miner()
