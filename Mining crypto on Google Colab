        config["miner_address"] = generate_address()
        atomic_write_json(config_path, config)
        logger.info("Network config created.")
    else:
        config = read_json(config_path, DEFAULT_CONFIG)
        changed = False
        for k, v in DEFAULT_CONFIG.items():
            if k not in config:
                config[k] = v
                changed = True
        if not config.get("miner_address"):
            config["miner_address"] = generate_address()
            changed = True
        if changed:
            atomic_write_json(config_path, config)
        logger.info("Network config loaded.")

    if not contract_path.exists():
        sol_content = """// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;
contract NPlusCoin {
    string public name = "NPlus Coin";
    string public symbol = "NPC";
    uint256 public totalSupply = 1000000000 * 10**18;
    mapping(address => uint256) public balanceOf;
    event Transfer(address indexed from, address indexed to, uint256 amount);
    constructor() {
        balanceOf[msg.sender] = totalSupply;
        emit Transfer(address(0), msg.sender, totalSupply);
    }
